        swapTo: {fileID: 11400000, guid: 3ca2c48a948cc6744a316cf8f6f1389b, type: 2}
        interactionNum: 2
        textNum: 0
    - rid: 3813937048124653676
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueLine: Yeah, kind of a shame. But I think the programmer did a good
          job showcasing this dialogue system.
